{
  "workbench.colorCustomizations": {
    "commandCenter.border": "#00000099",
    "commandCenter.foreground": "#000000",
    "editorGroup.border": "#ffffff",
    "panel.border": "#ffffff",
    "sash.hoverBorder": "#ffffff",
    "sideBar.border": "#ffffff",
    "tab.activeBorder": "#ffffff",
    "titleBar.activeBackground": "#d1e2fb",
    "titleBar.activeForeground": "#000000",
    "titleBar.border": "#d1e2fb",
    "titleBar.inactiveBackground": "#d1e2fb99",
    "titleBar.inactiveForeground": "#00000099"
  },
  "deno.enablePaths": [
    "supabase/functions"
  ],
  "deno.lint": true,
  "deno.unstable": [
    "bare-node-builtins",
    "byonm",
    "sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "ffi",
    "fs",
    "http",
    "net"
  ],
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  }
}
